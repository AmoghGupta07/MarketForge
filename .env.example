# Copy to .env and adjust. Real environment variables override this file.
DATABASE_URL=postgres://localhost/econsim
# While the app is closed your pay and bills are paused (markets keep moving).
# Set to 1 to live your whole life offline instead.
# MARKETFORGE_OFFLINE_PAY=0
# One tick (one simulated day) is N real seconds, live and when catching up
# (default 60; a 30-day month = 30 x N).
# MARKETFORGE_TICK_SECONDS=60
# The most game days the world catches up on after you've been away (default 1440).
# MARKETFORGE_MAX_AWAY_TICKS=1440
